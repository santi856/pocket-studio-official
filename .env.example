# Copy to .env and fill in for local development.
# Never commit .env. Never place real secrets in chat, prompts, or logs (Master Spec §4.7).

NODE_ENV=development

# Local Postgres started via `docker compose up -d db` (see docker-compose.yml).
DATABASE_URL="postgresql://pocket_studio:pocket_studio@localhost:5432/pocket_studio_dev"

# Used only by integration tests (tenant-isolation etc.) so they never run
# against development data. See docker/postgres-init/01-create-test-db.sql.
TEST_DATABASE_URL="postgresql://pocket_studio:pocket_studio@localhost:5432/pocket_studio_test"

# Generate with: openssl rand -base64 48
SESSION_SECRET="replace-with-a-random-48-byte-base64-string-min-32-chars"

# "mock" is the default and runs the full customer flow deterministically
# with no external calls. Set AI_PROVIDER=anthropic and provide a real
# ANTHROPIC_API_KEY below to use real AI generation (Master Spec §61).
AI_PROVIDER=mock
# ANTHROPIC_API_KEY=

# "keyword" is the default and uses the existing keyword-based impact
# classifier for conversational edits. Set IMPACT_ANALYSIS_MODE=graph to
# use the new Product Knowledge Graph traversal instead (Stage 3, D-0081).
IMPACT_ANALYSIS_MODE=keyword

# "mock" is the default and runs the full billing lifecycle
# deterministically with no external calls. Set BILLING_PROVIDER=stripe
# and provide both keys below for real Stripe webhooks/portal (Master
# Spec §61-§62).
BILLING_PROVIDER=mock
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# "mock" is the default — a real charge always authenticates with the
# *customer's own* connected payment-provider account (P3-05 OAuth), never
# a platform-level secret, so there is no key to set here.
GENERATED_APP_PAYMENT_PROVIDER=mock

# "mock" is the default and runs the full email-sending contract
# deterministically with no external connection. Set EMAIL_PROVIDER=smtp
# and provide all five values below for a real SMTP connection — any
# provider that speaks standard SMTP (Master Spec §61).
EMAIL_PROVIDER=mock
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USERNAME=
# SMTP_PASSWORD=
# EMAIL_FROM_ADDRESS=

# AES-256-GCM key for the credential vault (Master Spec §4.7, §30).
# Generate with: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY="replace-with-openssl-rand-base64-32-output"
