# Copy to .env and fill in for local development.
# Never commit .env. Never place real secrets in chat, prompts, or logs (Master Spec §4.7).

NODE_ENV=development

# Local Postgres started via `docker compose up -d db` (see docker-compose.yml).
DATABASE_URL="postgresql://pocket_studio:pocket_studio@localhost:5432/pocket_studio_dev"

# Used only by integration tests (tenant-isolation etc.) so they never run
# against development data. See docker/postgres-init/01-create-test-db.sql.
TEST_DATABASE_URL="postgresql://pocket_studio:pocket_studio@localhost:5432/pocket_studio_test"

# Generate with: openssl rand -base64 48
SESSION_SECRET="replace-with-a-random-48-byte-base64-string-min-32-chars"

# "mock" is the default and runs the full customer flow deterministically
# with no external calls. Set AI_PROVIDER=anthropic and provide a real
# ANTHROPIC_API_KEY below to use real AI generation (Master Spec §61).
AI_PROVIDER=mock
# ANTHROPIC_API_KEY=

# AES-256-GCM key for the credential vault (Master Spec §4.7, §30).
# Generate with: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY="replace-with-openssl-rand-base64-32-output"
