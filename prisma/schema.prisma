generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity, tenancy, and authorization foundation (Master Spec §50).
// Every tenant-scoped model below carries an explicit organizationId so
// authorization checks never rely on implicit joins.
// ---------------------------------------------------------------------------

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String?
  // P3-02 regression repair: the last time this user authenticated
  // successfully. Used to bound login-rate-limit enforcement to attempts
  // that happened *after* the account was last proven to belong to its
  // owner, without deleting the LoginAttempt history itself (Master Spec
  // §31 — a security audit trail must survive a subsequent successful
  // login, not be silently erased by it).
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions                  Session[]
  memberships               Membership[]
  platformAdminGrant        PlatformAdmin?
  requestedAccountDeletions AccountDeletionRequest[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// Internal administrative operations (Master Spec §61). A real, auditable
// admin grant -- who was granted access, by whom, when, and (if
// applicable) when it was revoked -- rather than a bare boolean flag on
// User, which would have no history. Platform-admin authority is
// deliberately cross-tenant (requirePlatformAdmin, src/lib/tenancy/
// platform-admin.ts) -- it is a separate authorization root from
// requireProjectAccess/requireOrganizationMembership, never derived from
// any organization's own membership.
// ---------------------------------------------------------------------------

model PlatformAdmin {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  grantedByUserId String?
  grantedAt       DateTime  @default(now())
  revokedAt       DateTime?
  revokedByUserId String?

  @@map("platform_admins")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

// P3-02: production auth hardening — brute-force protection. Deliberately
// not a User relation: recording an attempt against an email that has no
// account must behave identically to one that does, so a caller can never
// distinguish "no such account" from "account exists, wrong password" by
// timing or rate-limit behavior either.
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  // P3-02 regression repair: rate-limiting keyed by email alone let anyone
  // who merely knew a victim's email address lock them out of their own
  // account from anywhere (a real, confirmed denial-of-service — OWASP
  // ASVS explicitly warns against pure-account lockout for exactly this
  // reason). Keying by (email, ipAddress) means an attacker can only
  // throttle their own vantage point against a given email, not the
  // victim's own access to it. Residual, disclosed limitation: users
  // genuinely sharing one IP (NAT, office network) can still interfere
  // with each other — accepted as proportional for a V1 control, not
  // eliminated with heavier device/session fingerprinting.
  ipAddress String
  createdAt DateTime @default(now())

  @@index([email, ipAddress, createdAt])
  @@map("login_attempts")
}

enum EmailSendStatus {
  SENT
  FAILED
}

// P3-07: every send attempt, real or mock, is recorded — a failed send is
// a real, queryable fact (Master Spec §61 "production email"), never
// silently dropped. Not scoped to a project (email is a platform-level
// concern like auth, not a per-customer generated-app capability) —
// userId is optional correlation, not a tenant-isolation boundary.
model SentEmail {
  id                String          @id @default(cuid())
  userId            String?
  provider          String
  toAddress         String
  subject           String
  status            EmailSendStatus
  providerMessageId String?
  failureReason     String?
  createdAt         DateTime        @default(now())

  @@index([userId])
  @@map("sent_emails")
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships             Membership[]
  projects                Project[]
  subscription            OrganizationSubscription?
  auditLogEntries         AuditLogEntry[]
  aiUsageEvents           AiUsageEvent[]
  accountDeletionRequests AccountDeletionRequest[]

  @@map("organizations")
}

enum AccountDeletionStatus {
  PENDING
  CANCELED
  EXECUTED
}

// A customer-initiated, permanent account deletion request — deliberately
// separate from the billing lifecycle's own CANCELED -> RETENTION_PERIOD ->
// DELETED path (src/lib/billing/access.ts), which Master Spec §62 and
// customer-data-protection.integration.test.ts require to never delete
// customer-owned data as a *consequence of nonpayment*. This model exists
// for the different case: a customer explicitly asks to permanently delete
// their account and its data, independent of billing state. A 30-day
// scheduledPurgeAt grace period (founder decision, 2026-07-25) gives time
// to cancel a request made in error before executeDueAccountDeletions
// (src/lib/billing/account-deletion.ts) actually purges anything.
model AccountDeletionRequest {
  id                String                @id @default(cuid())
  organizationId    String
  organization      Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedByUserId String
  requestedBy       User                  @relation(fields: [requestedByUserId], references: [id])
  requestedAt       DateTime              @default(now())
  scheduledPurgeAt  DateTime
  status            AccountDeletionStatus @default(PENDING)
  canceledAt        DateTime?
  executedAt        DateTime?

  @@index([organizationId])
  @@map("account_deletion_requests")
}

// ---------------------------------------------------------------------------
// Observability (Master Spec §61: "monitoring and analytics; audit logs;
// cost tracking"; §31's "audit logs" security requirement). onDelete:
// SetNull (not Cascade, unlike almost every other organization-scoped
// model in this schema) is deliberate here: an audit trail or a real
// dollar-cost record must survive the deletion of the organization it
// describes, for the same forensic/compliance reason real audit systems
// never cascade-delete their own history.
// ---------------------------------------------------------------------------

enum AuditLogAction {
  CREDENTIAL_STORED
  CREDENTIAL_ACCESSED
  BILLING_STATE_TRANSITIONED
}

model AuditLogEntry {
  id             String         @id @default(cuid())
  organizationId String?
  organization   Organization?  @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actorUserId    String?
  action         AuditLogAction
  targetType     String
  targetId       String
  metadata       Json?
  createdAt      DateTime       @default(now())

  @@index([organizationId, createdAt])
  @@map("audit_log_entries")
}

// Real token counts from the AI provider's own response (Anthropic's
// Messages API returns exact input/output token counts) -- never
// estimated or guessed. estimatedCostCents is deliberately nullable: this
// build does not hardcode a specific dollar-per-token rate it cannot
// verify is current (the same "never fabricate, unknowns remain open"
// discipline already applied to legal-document generation, §34) -- cost
// is only computed when an operator explicitly configures a real,
// current rate (AI_COST_PER_1K_INPUT_TOKENS_CENTS/
// AI_COST_PER_1K_OUTPUT_TOKENS_CENTS, src/lib/env.ts).
model AiUsageEvent {
  id                 String        @id @default(cuid())
  organizationId     String?
  organization       Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  provider           String
  inputTokens        Int
  outputTokens       Int
  estimatedCostCents Int?
  createdAt          DateTime      @default(now())

  @@index([organizationId, createdAt])
  @@map("ai_usage_events")
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  INVESTIGATING
  RESOLVED
}

// Platform-wide, not organization-scoped (an incident can affect many
// tenants, or none in particular -- e.g. a provider outage). Operator-only
// record-keeping (Master Spec §31/§61 "incident response") -- no live
// monitoring/alerting integration exists or is authorized (no vendor
// named, the same honesty already applied to deployment hosting and
// governance-source monitoring); an incident is recorded once a real
// operator has identified one.
model IncidentReport {
  id          String           @id @default(cuid())
  title       String
  severity    IncidentSeverity
  status      IncidentStatus
  description String
  rootCause   String?
  remediation String?
  detectedAt  DateTime
  resolvedAt  DateTime?

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status, detectedAt])
  @@map("incident_reports")
}

model Membership {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           MembershipRole
  createdAt      DateTime       @default(now())

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("memberships")
}

model Project {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String
  slug            String
  createdByUserId String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  productStates               ProductState[]
  productDnaVersions          ProductDNA[]
  memoryEntries               ProductMemoryEntry[]
  knowledgeNodes              ProductKnowledgeNode[]
  knowledgeEdges              ProductKnowledgeEdge[]
  decisions                   Decision[]
  events                      ProductEvent[]
  evidenceRecords             ProductEvidence[]
  truthStatuses               TruthStatusEntry[]
  integrationRequirements     IntegrationRequirement[]
  credentialReferences        CredentialReference[]
  governanceProfile           GovernanceProfile?
  policyDocuments             PolicyDocument[]
  productSemanticModels       ProductSemanticModel[]
  blueprints                  Blueprint[]
  buildPlans                  BuildPlan[]
  generatedAppUsers           GeneratedAppUser[]
  generatedRecords            GeneratedRecord[]
  changeSets                  ChangeSet[]
  jobRuns                     JobRun[]
  oauthConnectionStates       OAuthConnectionState[]
  generatedAppPayments        GeneratedAppPayment[]
  deployments                 Deployment[]
  exportRecords               ExportRecord[]
  storeSubmissions            StoreSubmission[]
  policyAcceptances           PolicyAcceptance[]
  governanceImpactAssessments GovernanceImpactAssessment[]
  productOutcomeRecords       ProductOutcomeRecord[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("projects")
}

enum DecisionDisclosureTier {
  ROUTINE
  IMPORTANT
  CONSEQUENTIAL
}

enum DecisionApprovalStatus {
  AUTO_APPLIED
  RECOMMENDED
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

// Product-facing Decision Ledger (Master Spec §15) — distinct from
// execution/decisions/ledger.jsonl, which records *this build's own*
// architecture decisions. This table records decisions Pocket Studio makes
// or recommends *about a customer's product*. Disclosure tiers: ROUTINE
// applies automatically and is recorded for the record; IMPORTANT
// recommends a default and summarizes it; CONSEQUENTIAL must be explained
// and explicitly approved before taking effect in production.
model Decision {
  id             String                 @id @default(cuid())
  projectId      String
  project        Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  source         String
  summary        String
  recommendation String?
  alternatives   Json?
  reason         String?
  impact         Json?
  risk           String?
  disclosureTier DecisionDisclosureTier
  approvalStatus DecisionApprovalStatus

  customerResponse  String?
  respondedAt       DateTime?
  respondedByUserId String?

  effectiveVersion String?
  evidenceRef      String?

  createdByUserId String?
  createdAt       DateTime @default(now())

  changeSet ChangeSet?

  @@index([projectId])
  @@index([projectId, approvalStatus])
  @@map("decisions")
}

// ---------------------------------------------------------------------------
// Canonical Product State, Product DNA, Product Memory, and Product
// Knowledge relationships (Master Spec §9-12). Phase 1 persists and
// versions these; Phase 2's Blueprint/Build Plan/generation systems are the
// first things to populate Workflow/Screen/DataModel-typed knowledge nodes
// in earnest — Phase 1 only needs the durable structure and Requirement
// nodes emitted by the Requirements Engine (P1-06).
// ---------------------------------------------------------------------------

// Append-only: each call to the product-state service creates a new row
// rather than mutating one in place, so "current state" is always
// `orderBy(version desc) take 1` and prior states remain inspectable
// evidence (Master Spec §9 lists "versions" as part of the canonical state).
model ProductState {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version   Int

  originalIdea                String
  productIntelligence         Json?
  feasibilityReport           Json?
  businessModelBrief          Json?
  monetizationRecommendations Json?
  unitEconomicsAssumptions    Json?
  operationalComplexity       Json?
  requiredIntegrations        Json?
  outputTargets               Json?
  governanceRequirements      Json?

  createdAt       DateTime @default(now())
  createdByUserId String

  @@unique([projectId, version])
  @@index([projectId])
  @@map("product_states")
}

// Same append-only pattern as ProductState. The service layer enforces
// "edits must not silently erase Product DNA" (Master Spec §10) by merging
// a partial update onto the previous version rather than accepting a bare
// replacement.
model ProductDNA {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version   Int

  originalIdea          String
  purpose               String?
  problem               String?
  targetUsers           Json?
  productThesis         String?
  differentiation       String?
  productEdge           String?
  customerPromise       String?
  brandDirection        Json?
  businessModel         String?
  monetizationDirection String?
  constraints           Json?
  nonNegotiables        Json?
  acceptedDecisions     Json?
  rejectedDecisions     Json?
  openQuestions         Json?
  knownRisks            Json?

  createdAt       DateTime @default(now())
  createdByUserId String

  @@unique([projectId, version])
  @@index([projectId])
  @@map("product_dna_versions")
}

enum ProductMemoryEntryType {
  FACT
  REQUIREMENT
  RECOMMENDATION
  DECISION
  REJECTED_OPTION
  CONSTRAINT
  PREFERENCE
  HISTORY
  LIMITATION
  OPEN_QUESTION
  CONTEXT
}

// Discrete, appendable memory entries rather than one blob — Master Spec
// §11 requires memory to be "inspectable, correctable, exportable,
// deletable according to policy" per entry, and explicitly rejects
// "unbounded chat history" as the sole memory architecture.
model ProductMemoryEntry {
  id              String                 @id @default(cuid())
  projectId       String
  project         Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type            ProductMemoryEntryType
  content         String
  metadata        Json?
  createdByUserId String?
  createdAt       DateTime               @default(now())

  @@index([projectId])
  @@index([projectId, type])
  @@map("product_memory_entries")
}

enum ProductKnowledgeNodeType {
  REQUIREMENT
  WORKFLOW
  SCREEN
  ACTION
  DATA_MODEL
  PERMISSION
  INTEGRATION
  IMPLEMENTATION
  TEST
  EVIDENCE
}

// Requirement → Workflow → Screen → Action → Data Model → Permission →
// Integration → Implementation → Test → Evidence (Master Spec §12). Stable
// cuid identifiers on nodes and edges are what make impact analysis and
// selective regeneration possible later — this is deliberately a generic
// typed graph rather than one table per node type, because the edge shape
// (which types connect to which) is a Phase 2 orchestration concern, not a
// Phase 1 schema concern.
model ProductKnowledgeNode {
  id        String                   @id @default(cuid())
  projectId String
  project   Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type      ProductKnowledgeNodeType
  label     String
  data      Json?
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt

  outgoingEdges  ProductKnowledgeEdge[] @relation("SourceNode")
  incomingEdges  ProductKnowledgeEdge[] @relation("TargetNode")
  outcomeRecords ProductOutcomeRecord[]

  @@index([projectId])
  @@index([projectId, type])
  @@map("product_knowledge_nodes")
}

// Stage 2 architecture proposal (D-0080), corrected during Stage 2 acceptance
// review (D-0081, execution/architecture/STAGE_2_ARCHITECTURE_PROPOSAL.md
// §10.1): the acceptance review found ProductKnowledgeEdge had no
// type-discriminating field at all — the entire governed edge taxonomy
// depended on one that did not exist. Approved for Stage 3: CONTAINS,
// TRIGGERS, DEPENDS_ON only — VERIFIED_BY is deferred to Stage 3+1 (its only
// valid targets, TEST/EVIDENCE nodes, are not populated by this slice).
enum ProductKnowledgeEdgeType {
  CONTAINS
  TRIGGERS
  DEPENDS_ON
}

model ProductKnowledgeEdge {
  id           String                   @id @default(cuid())
  projectId    String
  project      Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceNodeId String
  sourceNode   ProductKnowledgeNode     @relation("SourceNode", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  targetNodeId String
  targetNode   ProductKnowledgeNode     @relation("TargetNode", fields: [targetNodeId], references: [id], onDelete: Cascade)
  edgeType     ProductKnowledgeEdgeType
  // Free-form record of which Blueprint field/category-template entry
  // produced this edge (e.g. { "sourceField": "actions[].triggersWorkflow",
  // "categoryTemplate": "monetization" }) — always populated by the Graph
  // Projector in Stage 3. Nullable only because a future AI-backed edge
  // producer (not built) would reuse this same field for a different
  // provenance shape rather than requiring a second migration.
  provenance   Json?
  createdAt    DateTime                 @default(now())

  @@unique([sourceNodeId, targetNodeId, edgeType])
  @@index([projectId])
  @@map("product_knowledge_edges")
}

// Master Spec §61 "Product Outcome foundation" — real, recorded outcome
// facts (never estimated) optionally tied to a specific node in the
// existing Product Knowledge Graph (§12), giving analytics (P3-12) a real
// historical record instead of only a recomputed-on-demand snapshot.
// knowledgeNodeId is nullable/SetNull: an outcome fact must survive its
// knowledge node being regenerated (Blueprint/Build Plan are full-replace
// versioned, P2-01) — the historical fact is not invalidated just because
// the graph node that produced it was superseded.
model ProductOutcomeRecord {
  id              String                @id @default(cuid())
  projectId       String
  project         Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  knowledgeNodeId String?
  knowledgeNode   ProductKnowledgeNode? @relation(fields: [knowledgeNodeId], references: [id], onDelete: SetNull)
  metricKey       String
  value           Float
  source          String
  recordedAt      DateTime              @default(now())

  @@index([projectId, metricKey, recordedAt])
  @@map("product_outcome_records")
}

// ---------------------------------------------------------------------------
// Capability and Feasibility Engine / Supported Capability Registry
// (Master Spec §16). Platform-wide, not tenant-scoped — this is Pocket
// Studio's own catalog of what it may promise, not customer data. Written
// by internal seed/admin operations, read by the Feasibility Engine.
// ---------------------------------------------------------------------------

// Mirrors the Master Spec §4.3 classification exactly so the registry can
// never drift from the governing taxonomy of what Pocket Studio may claim.
enum CapabilityImplementationLevel {
  SUPPORTED_NOW
  SUPPORTED_WITH_CONFIGURATION
  SUPPORTED_WITH_CUSTOMER_INTEGRATION
  SUPPORTED_LATER_PHASE
  PROTOTYPE_ONLY
  PLANNING_ONLY
  EXTERNAL_APPROVAL_REQUIRED
  PROFESSIONAL_REVIEW_REQUIRED
  NOT_CURRENTLY_SUPPORTED
  UNSAFE_OR_PROHIBITED
  INSUFFICIENT_INFORMATION
}

enum CapabilityRiskClass {
  LOW
  MEDIUM
  HIGH
}

// Append-only per capabilityKey, same versioning pattern as ProductState/
// ProductDNA: "current" is the latest version for a given key, and prior
// versions remain inspectable evidence of what Pocket Studio used to
// promise (or not) at a point in time.
model CapabilityRegistryEntry {
  id            String @id @default(cuid())
  capabilityKey String
  version       Int

  label                String
  category             String
  outputTargets        Json?
  implementationLevel  CapabilityImplementationLevel
  requiredIntegrations Json?
  evidenceStandard     String?
  riskClass            CapabilityRiskClass
  limitations          Json?
  providerDependencies Json?
  launchImplications   String?

  createdAt       DateTime @default(now())
  createdByUserId String?

  @@unique([capabilityKey, version])
  @@index([capabilityKey])
  @@map("capability_registry_entries")
}

// ---------------------------------------------------------------------------
// Product-facing Event Ledger, Evidence Ledger, and Truth Status (Master
// Spec §50, §53). Distinct from execution/{evidence,decisions}/*.jsonl,
// which record this *build's own* process — these record facts about a
// customer's project, tenant-scoped like everything else in this section.
// ---------------------------------------------------------------------------

enum ProductEventType {
  PRODUCT_STATE_VERSION_CREATED
  PRODUCT_DNA_VERSION_CREATED
  DECISION_RECORDED
  DECISION_RESPONDED
  TRUTH_STATUS_UPDATED
  BLUEPRINT_VERSION_CREATED
  BUILD_PLAN_VERSION_CREATED
  GENERATION_COMPLETED
  CHANGE_SET_APPLIED
  CHANGE_SET_REJECTED
  BLUEPRINT_RESTORED
  QUALITY_GATE_RUN
}

// Append-only audit trail of state-changing actions on a project. Never
// updated or deleted — a wrong past event is corrected by a new event, not
// by rewriting history (same principle as the append-only versioned models
// elsewhere in this schema).
model ProductEvent {
  id          String           @id @default(cuid())
  projectId   String
  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type        ProductEventType
  summary     String
  data        Json?
  actorUserId String?
  createdAt   DateTime         @default(now())

  @@index([projectId])
  @@index([projectId, type])
  @@map("product_events")
}

enum ProductEvidenceType {
  FEASIBILITY_ASSESSMENT
  REQUIREMENT_DERIVATION
  STRUCTURED_MANUAL_VERIFICATION
  QUALITY_GATE_CHECK
  DEPLOYMENT_ATTEMPT
  STORE_SUBMISSION_ATTEMPT
  // Stage 3 (D-0081/D-0082): how many of a generation's candidate
  // CONTAINS/TRIGGERS/DEPENDS_ON relationships the Graph Projector
  // actually persisted, out of how many candidates — surfaced by the new
  // Quality Gate check (Migration Plan Phase 3) as a non-blocking,
  // disclosed finding, never a silent gap.
  GRAPH_PROJECTION
}

// Backs Truth Status claims with a verifiable record, mirroring the
// Evidence Contract shape from Execution Protocol §10 but scoped to a
// customer's project rather than this build's own process. Phase 1 has no
// generated application to test/build/deploy yet, so evidence here is
// necessarily about *intelligence-generation* claims (what was assessed,
// how, and with what result) — not implementation evidence, which only
// becomes possible once Phase 2 generation exists.
model ProductEvidence {
  id                 String              @id @default(cuid())
  projectId          String
  project            Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  evidenceType       ProductEvidenceType
  subjectKey         String
  verificationMethod String
  result             String
  limitations        String?
  createdByUserId    String?
  createdAt          DateTime            @default(now())

  @@index([projectId])
  @@index([projectId, subjectKey])
  @@map("product_evidence")
}

enum TruthStatusValue {
  IMPLEMENTED
  PLANNED
  MISSING
  BLOCKED
  UNSUPPORTED
  NOT_EVALUATED
}

// Append-only versioned per (projectId, subjectKey) — same "latest wins,
// history preserved" pattern as ProductState/ProductDNA/CapabilityRegistry.
// subjectKey is typically a Supported Capability Registry key so a
// project's Truth Status can be cross-referenced against the platform
// registry that justifies it.
model TruthStatusEntry {
  id              String           @id @default(cuid())
  projectId       String
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subjectKey      String
  subjectLabel    String
  version         Int
  status          TruthStatusValue
  evidenceRef     String?
  rationale       String?
  createdByUserId String?
  createdAt       DateTime         @default(now())

  @@unique([projectId, subjectKey, version])
  @@index([projectId])
  @@index([projectId, subjectKey])
  @@map("truth_status_entries")
}

// ---------------------------------------------------------------------------
// Customer-owned integrations, credential vault, governance profile, and
// policy-document scaffolding (Master Spec §4.7, §30, §32, §34).
// ---------------------------------------------------------------------------

enum IntegrationRequirementLevel {
  REQUIRED
  OPTIONAL
  NOT_NEEDED
}

enum IntegrationOwner {
  POCKET_STUDIO
  CUSTOMER
  POCKET_STUDIO_MANAGED
}

enum IntegrationConnectionStatus {
  NOT_NEEDED
  RECOMMENDED
  REQUIRED
  SETUP_NEEDED
  CONNECTED
  DISCONNECTED
  MISSING
  BLOCKED
}

// One row per (project, category) — mutable, not append-only versioned,
// because this tracks *current connection state* (Master Spec §30), not a
// historical intelligence artifact. Status transitions are still visible
// via the Event Ledger once a caller records them there.
model IntegrationRequirement {
  id                String                      @id @default(cuid())
  projectId         String
  project           Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category          String
  purpose           String
  requirementLevel  IntegrationRequirementLevel
  providerOptions   Json?
  selectedProvider  String?
  owner             IntegrationOwner
  connectionStatus  IntegrationConnectionStatus
  setupRequirements String?
  costNotes         String?
  securityNotes     String?
  privacyNotes      String?
  launchImpact      String?
  fallbackBehavior  String?

  credential CredentialReference?
  payments   GeneratedAppPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, category])
  @@index([projectId])
  @@map("integration_requirements")
}

// Never stores a secret in plaintext. `ciphertext`/`iv`/`authTag` are the
// three AES-256-GCM outputs (base64) from src/lib/credentials/crypto.ts —
// decryption requires CREDENTIAL_ENCRYPTION_KEY, which lives only in the
// server environment, never in this table, a prompt, a log, or a client
// bundle (Master Spec §4.7).
model CredentialReference {
  id                       String                 @id @default(cuid())
  projectId                String
  project                  Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  integrationRequirementId String                 @unique
  integrationRequirement   IntegrationRequirement @relation(fields: [integrationRequirementId], references: [id], onDelete: Cascade)
  provider                 String
  ciphertext               String
  iv                       String
  authTag                  String
  lastVerifiedAt           DateTime?
  createdByUserId          String?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt

  @@index([projectId])
  @@map("credential_references")
}

// P3-05: a real OAuth2 authorization-code flow needs a server-tracked
// `state` value to verify a callback genuinely continues the request this
// project's own member initiated (CSRF protection) — a client-supplied
// state alone proves nothing. Single-use: deleted the moment
// completeOAuthConnection consumes it, so a replayed callback can never
// succeed twice.
model OAuthConnectionState {
  id                       String   @id @default(cuid())
  state                    String   @unique
  projectId                String
  project                  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  integrationRequirementId String
  createdByUserId          String
  createdAt                DateTime @default(now())

  @@index([projectId])
  @@map("oauth_connection_states")
}

// One mutable profile per project (Master Spec §32). Deliberately does
// *not* include the full Governance Requirement Registry (external legal-
// source tracking, effective/enforcement dates, etc.) — that requires
// Continuous Governance Monitoring, which Master Spec §33/§65 explicitly
// assigns to Phase 3. Phase 1 only needs the project-level facts a future
// governance check will be evaluated against.
model GovernanceProfile {
  id                        String  @id @default(cuid())
  projectId                 String  @unique
  project                   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  businessLocations         Json?
  userLocations             Json?
  productCategory           String?
  userAgeRange              String?
  dataCategories            Json?
  monetizationModel         String?
  distributionChannels      Json?
  relevantGovernanceDomains Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("governance_profiles")
}

enum PolicyDocumentType {
  TERMS_OF_SERVICE
  PRIVACY_POLICY
  ACCEPTABLE_USE_POLICY
  COOKIE_NOTICE
  AI_DISCLOSURE
  SUBSCRIPTION_TERMS
  CANCELLATION_REFUND_POLICY
  DATA_RETENTION_DELETION_POLICY
  SUPPORT_POLICY
  ACCESSIBILITY_STATEMENT
  COMMUNICATIONS_CONSENT
  MOBILE_PERMISSION_EXPLANATION
  MARKETPLACE_TERMS
}

enum PolicyDocumentStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  PUBLISHED
}

// Versioned per (projectId, type, language) — Master Spec §34/§35 require
// tracking both legal-document versions and their translations
// independently. Phase 1 only needs the durable, versioned model; actual
// drafting against real Product State and professional-review workflows
// are populated by later phases/units.
model PolicyDocument {
  id                         String               @id @default(cuid())
  projectId                  String
  project                    Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type                       PolicyDocumentType
  version                    Int
  status                     PolicyDocumentStatus
  content                    String
  language                   String               @default("en")
  basedOnProductStateVersion Int?
  createdByUserId            String?
  createdAt                  DateTime             @default(now())

  // P3-10: professional review is a real, recorded attestation (who, when)
  // that a qualified reviewer looked at this draft -- Pocket Studio never
  // performs the review itself (Master Spec §32's "not legal advice"
  // boundary). Nullable/independent of `status`: a document can be
  // professionally reviewed before or separately from the customer's own
  // approval step.
  professionallyReviewed Boolean   @default(false)
  reviewerName           String?
  reviewedAt             DateTime?

  approvedByUserId String?
  approvedAt       DateTime?
  publishedAt      DateTime?

  // Only meaningful when language != "en" -- which English version this
  // translation was produced from, so a later, newer English version can
  // be detected as making this translation stale (§35).
  translatedFromVersion Int?

  acceptances PolicyAcceptance[]

  @@unique([projectId, type, language, version])
  @@index([projectId])
  @@map("policy_documents")
}

// Master Spec §61 "policy publication and acceptance tracking where
// supported". Tracks a generated product's own end user accepting a
// specific PUBLISHED PolicyDocument version -- one row per (document,
// user): re-accepting a newer version is a new row, preserving exactly
// which version a given user actually agreed to.
model PolicyAcceptance {
  id                 String           @id @default(cuid())
  projectId          String
  project            Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  policyDocumentId   String
  policyDocument     PolicyDocument   @relation(fields: [policyDocumentId], references: [id], onDelete: Cascade)
  generatedAppUserId String
  generatedAppUser   GeneratedAppUser @relation(fields: [generatedAppUserId], references: [id], onDelete: Cascade)
  acceptedAt         DateTime         @default(now())

  @@unique([policyDocumentId, generatedAppUserId])
  @@index([projectId])
  @@map("policy_acceptances")
}

// ---------------------------------------------------------------------------
// Continuous governance monitoring (Master Spec §32-33, §61: "continuous
// governance-source monitoring; governance change detection and impact;
// customer notification and remediation; professional-review workflow").
// GovernanceRequirement is platform-wide (append-only per requirementKey,
// same versioning shape as CapabilityRegistryEntry/PlanDefinition) --
// recording what a real authoritative source says is an operator action,
// not a customer one, so these functions carry no requireProjectAccess
// check, the same posture already established for
// upsertCapabilityVersion. No real external source is monitored
// automatically (no live legal/regulatory API is named or authorized,
// the same "no real provider" honesty already applied to hosting (P3-08)
// and app-store review (P3-09)) -- a requirement is recorded once a real,
// disclosed operator has verified it against a real source.
// GovernanceImpactAssessment is the project-scoped "affected-project
// mapping" through the rest of the pipeline: remediation proposal →
// customer notification → approval → implementation → validation.
// ---------------------------------------------------------------------------

enum GovernanceInterpretationStatus {
  UNVERIFIED
  VERIFIED_NO_IMPACT
  VERIFIED_MATERIAL
  PROFESSIONAL_REVIEW_PENDING
  PROFESSIONAL_REVIEW_COMPLETE
}

model GovernanceRequirement {
  id             String @id @default(cuid())
  requirementKey String
  version        Int

  domain                     String
  jurisdiction               String
  authority                  String
  officialSource             String
  applicability              String
  affectedCapabilities       Json
  effectiveDate              DateTime?
  enforcementDate            DateTime?
  verificationDate           DateTime
  changeSummary              String
  interpretationStatus       GovernanceInterpretationStatus
  professionalReviewRequired Boolean

  createdByUserId String?
  createdAt       DateTime @default(now())

  impactAssessments GovernanceImpactAssessment[]

  @@unique([requirementKey, version])
  @@index([requirementKey])
  @@map("governance_requirements")
}

enum GovernanceImpactMateriality {
  NOT_MATERIAL
  MATERIAL
}

enum GovernanceImpactStatus {
  IDENTIFIED
  NOTIFIED
  APPROVED
  IMPLEMENTED
  VALIDATED
  DISMISSED
}

model GovernanceImpactAssessment {
  id                      String                      @id @default(cuid())
  projectId               String
  project                 Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  governanceRequirementId String
  governanceRequirement   GovernanceRequirement       @relation(fields: [governanceRequirementId], references: [id], onDelete: Cascade)
  materiality             GovernanceImpactMateriality
  status                  GovernanceImpactStatus
  remediationProposal     String?
  dismissedReason         String?

  notifiedAt       DateTime?
  approvedByUserId String?
  approvedAt       DateTime?
  implementedAt    DateTime?
  validatedAt      DateTime?

  createdByUserId String?
  createdAt       DateTime @default(now())

  @@index([projectId])
  @@index([governanceRequirementId])
  @@map("governance_impact_assessments")
}

// ---------------------------------------------------------------------------
// Plans, entitlements, and billing-state architecture (Master Spec §36-37).
// Architecture only in Phase 1 — no live billing, webhooks, or real
// charges (explicit Phase 3 scope, §62). Billing is an organization-level
// concern (the account/workspace subscribes), not project-level.
// ---------------------------------------------------------------------------

enum PlanKey {
  FREE_EXPLORE
  BUILDER
  LAUNCH
  MANAGED
  AGENCY
}

// Platform-wide (like CapabilityRegistryEntry), append-only versioned per
// planKey. `monthlyPriceCents`/`annualPriceCents` are nullable and only
// ever set from an explicit, supplied value — Master Spec §36: "final
// prices remain configurable and must not be invented when not supplied."
model PlanDefinition {
  id      String  @id @default(cuid())
  planKey PlanKey
  version Int

  name              String
  monthlyPriceCents Int?
  annualPriceCents  Int?
  currency          String @default("usd")
  entitlements      Json

  createdAt       DateTime @default(now())
  createdByUserId String?

  @@unique([planKey, version])
  @@index([planKey])
  @@map("plan_definitions")
}

// Mirrors Master Spec §37's supported billing-provider states exactly.
enum BillingState {
  TRIALING
  ACTIVE
  PAST_DUE
  PAYMENT_RETRYING
  GRACE_PERIOD
  RESTRICTED
  SUSPENDED
  CANCELED
  EXPIRED
  RETENTION_PERIOD
  DELETION_SCHEDULED
  DELETED
}

// One row per organization — "billing provider state is authoritative"
// (§37). Mutable in place (current state), with BillingEvent as the
// append-only history of how it got there.
model OrganizationSubscription {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planKey        PlanKey      @default(FREE_EXPLORE)
  billingState   BillingState @default(TRIALING)

  // P3-04: null until this organization connects real billing (Pocket
  // Studio's own provider, not the customer-owned integrations
  // CredentialReference already covers) — nullable and unique so a real
  // provider customer/subscription id can never be silently attached to
  // more than one organization.
  billingProviderCustomerId     String? @unique
  billingProviderSubscriptionId String? @unique

  trialEndsAt       DateTime?
  currentPeriodEnd  DateTime?
  gracePeriodEndsAt DateTime?
  canceledAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events BillingEvent[]

  @@map("organization_subscriptions")
}

// P3-04: webhook delivery is at-least-once, never exactly-once (Stripe's
// own documented guarantee) -- every processed event is recorded here so
// a redelivered event is a safe no-op, never a double-applied billing
// state transition.
model ProcessedWebhookEvent {
  id              String   @id @default(cuid())
  provider        String
  providerEventId String
  processedAt     DateTime @default(now())

  @@unique([provider, providerEventId])
  @@map("processed_webhook_events")
}

enum BillingEventType {
  SUBSCRIPTION_CREATED
  STATE_TRANSITIONED
  PAYMENT_FAILED
  PAYMENT_RETRY_SCHEDULED
  PAYMENT_RECOVERED
  RESTRICTED
  SUSPENDED
  RESTORED
  CANCELED
  // A real Stripe Checkout Session completing (CHECKOUT_COMPLETED,
  // access.ts) — distinct from PAYMENT_RECOVERED, which is a
  // renewal/recovery signal from a failure-adjacent state, not a first
  // subscription or a resubscribe after cancellation.
  SUBSCRIPTION_ACTIVATED
}

// Append-only audit trail of billing-state transitions — same pattern as
// ProductEvent, scoped to a subscription instead of a project.
model BillingEvent {
  id                         String                   @id @default(cuid())
  organizationSubscriptionId String
  organizationSubscription   OrganizationSubscription @relation(fields: [organizationSubscriptionId], references: [id], onDelete: Cascade)
  type                       BillingEventType
  fromState                  BillingState?
  toState                    BillingState?
  summary                    String
  data                       Json?
  createdAt                  DateTime                 @default(now())

  @@index([organizationSubscriptionId])
  @@map("billing_events")
}

// ---------------------------------------------------------------------------
// Semantic Product Compiler (founder-directed repair, post-Phase-3,
// D-0065/EV-0110 — see execution/architecture/SEMANTIC_PRODUCT_COMPILER_REPORT.md).
// Sits between Product State and Blueprint: a domain-agnostic, versioned,
// structured representation of what a customer's description actually
// means (actors, entities, relationships, workflows, permissions, business
// rules, monetization, constraints), with inline provenance on every
// material item, so Blueprint generation has something richer than a bare
// Impact Analysis category list to draw from. Does not replace Product
// State (still the raw-idea/business-intelligence container), Product
// Knowledge (still the graph-relationship layer this feeds), or the
// Decision Ledger (consequential items still route through it). Full-
// replace versioned, like Blueprint and ProductState.
// ---------------------------------------------------------------------------

model ProductSemanticModel {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version   Int

  schemaVersion String

  purpose       String?
  targetUsers   Json?
  actors        Json?
  entities      Json?
  workflows     Json?
  capabilities  Json?
  permissions   Json?
  businessRules Json?
  monetization  Json?
  integrations  Json?
  constraints   Json?

  unresolvedQuestions     Json?
  consequentialDecisions  Json?
  unsupportedRequirements Json?

  // { generatedBy: "mock"|"anthropic", model: string|null, promptVersion:
  // string, generatedAt: ISO string, mode: "ai"|"deterministic_fallback" }
  generationMetadata Json

  // Written by the Semantic Coverage Engine (semantic-coverage.ts) after
  // extraction — per-dimension covered/partially_covered/unresolved/
  // unsupported/deferred/missing, never a single aggregate percentage.
  coverageResult Json?

  basedOnProductStateVersion Int

  createdAt       DateTime @default(now())
  createdByUserId String

  @@unique([projectId, version])
  @@index([projectId])
  @@map("product_semantic_models")
}

// ---------------------------------------------------------------------------
// Blueprint Engine (Master Spec §23, Phase 2). A versioned, validated
// Blueprint is the structured artifact the Build Planner and full-stack
// generation pipeline consume — never a hardcoded preview screen (§26).
// Full-replace versioned, like ProductState: each new version is generated
// fresh from the current Product State/DNA (P2-01) or a validated Change Set
// (P2-08), never a partial patch onto the previous version.
// ---------------------------------------------------------------------------

enum BlueprintValidationStatus {
  VALID
  INVALID
}

model Blueprint {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version   Int

  // Blueprint's own document-schema version (Master Spec §23 "schema
  // version"), distinct from `version` (this row's position in the
  // project's append-only Blueprint history).
  schemaVersion String

  productType     String?
  targetUsers     Json?
  roles           Json?
  requirements    Json?
  workflows       Json?
  screens         Json?
  navigation      Json?
  dataModels      Json?
  permissions     Json?
  actions         Json?
  integrations    Json?
  businessRules   Json?
  monetization    Json?
  subscriptions   Json?
  ownerOperations Json?
  outputTargets   Json?
  themeAndStyle   Json?

  // Product Pattern and Interaction Contract System
  // (src/lib/generation/interaction-contracts.ts): per-screen/workflow
  // inferred product patterns and the interaction states (loading, empty,
  // error, confirmation, etc.) they imply. Optional at the schema level
  // for forward compatibility, but the generator always populates it and
  // `validateBlueprint` enforces completeness whenever it is present.
  interactionContracts Json?
  assumptions          Json?
  openDecisions        Json?
  memory               Json?
  security             Json?
  privacy              Json?
  accessibility        Json?
  governance           Json?
  feasibility          Json?

  generationMetadata Json?

  validationStatus BlueprintValidationStatus
  validationErrors Json?

  basedOnProductStateVersion Int?
  basedOnProductDnaVersion   Int?

  createdAt       DateTime @default(now())
  createdByUserId String

  @@unique([projectId, version])
  @@index([projectId])
  @@map("blueprints")
}

// ---------------------------------------------------------------------------
// Build Planner (Master Spec §24, Phase 2). Derives a versioned Build Plan
// structurally from the latest Blueprint — full-replace versioned, like
// Blueprint itself, since a plan is generated fresh from the Blueprint it is
// based on rather than patched incrementally.
// ---------------------------------------------------------------------------

enum BuildPlanStatus {
  READY
  BLOCKED
}

model BuildPlan {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version   Int

  basedOnBlueprintVersion Int
  planStatus              BuildPlanStatus

  implementationPhases       Json
  dependencies               Json
  screenOrder                Json
  componentStructure         Json
  navigationGraph            Json
  dataDependencies           Json
  backendAndBusinessLogic    Json
  administrativeRequirements Json
  integrations               Json
  monetization               Json
  platformRequirements       Json
  persistence                Json
  tests                      Json
  acceptanceCriteria         Json
  evidenceRequirements       Json
  risk                       Json
  blockers                   Json

  generationMetadata Json?

  createdAt       DateTime @default(now())
  createdByUserId String

  @@unique([projectId, version])
  @@index([projectId])
  @@map("build_plans")
}

// ---------------------------------------------------------------------------
// Generated-app data layer (Master Spec §25, Phase 2). A generated product
// needs its own end-user identity and its own data records, distinct from
// Pocket Studio's own platform User/Membership/Organization — the person
// booking a detailing appointment is not a Pocket Studio account holder.
// Rather than dynamically generating and running arbitrary per-customer
// Postgres schema migrations (which Master Spec §28's migration-safety
// requirements make risky to do blindly), every generated product's data
// lives in a generic, project-scoped store: GeneratedAppUser for its end
// users, GeneratedRecord for everything else, keyed by the Build Plan's
// `modelKey` (a Blueprint data model's name). Mutable in place — a
// generated product's own data is live application state, not a versioned
// intelligence artifact like Blueprint/BuildPlan.
// ---------------------------------------------------------------------------

// Project-scoped, not globally unique — two different generated products
// may legitimately have end users who share an email address, since they
// are unrelated products with unrelated user bases.
model GeneratedAppUser {
  id           String  @id @default(cuid())
  projectId    String
  project      Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  email        String
  passwordHash String
  name         String?
  // A Blueprint role name (e.g. "customer", "owner") — not a fixed enum,
  // since a Blueprint's roles are themselves derived, product-specific data
  // (src/lib/generation/blueprint-templates.ts), not a platform-wide set.
  role         String

  ownedRecords      GeneratedRecord[]
  payments          GeneratedAppPayment[]
  policyAcceptances PolicyAcceptance[]
  sessions          GeneratedAppSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, email])
  @@index([projectId])
  @@map("generated_app_users")
}

// A real, live session for a generated product's own end user — the
// missing binding disclosed by generated-app-auth.ts's own docstring
// (authenticateGeneratedAppUser verifies credentials but previously
// established no session). Mirrors Session (platform users) exactly:
// only a SHA-256 hash of the token is ever stored, so a database read can
// never be replayed as a live session. Deliberately its own model rather
// than a nullable-userId variant of Session — GeneratedAppUser and User are
// different identity domains (Master Spec §25), and conflating them would
// let a generated app's own end user and a Pocket Studio platform member
// collide in one session table for no real benefit.
model GeneratedAppSession {
  id                 String           @id @default(cuid())
  generatedAppUserId String
  generatedAppUser   GeneratedAppUser @relation(fields: [generatedAppUserId], references: [id], onDelete: Cascade)
  tokenHash          String           @unique
  expiresAt          DateTime
  createdAt          DateTime         @default(now())

  @@index([generatedAppUserId])
  @@map("generated_app_sessions")
}

enum GeneratedAppPaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

// P3-06: a real charge or subscription payment collected by a generated
// product from its own end user, through the *customer's own* connected
// payment-provider account (IntegrationRequirement owner=CUSTOMER,
// category=payments — Master Spec §61 "customer-owned generated-app
// payment and subscription connections"). Distinct from BillingEvent
// (Pocket Studio's own subscription revenue, P3-04) — this is the
// generated product's revenue, never Pocket Studio's.
model GeneratedAppPayment {
  id                       String                    @id @default(cuid())
  projectId                String
  project                  Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  integrationRequirementId String
  integrationRequirement   IntegrationRequirement    @relation(fields: [integrationRequirementId], references: [id], onDelete: Cascade)
  generatedAppUserId       String?
  generatedAppUser         GeneratedAppUser?         @relation(fields: [generatedAppUserId], references: [id], onDelete: SetNull)
  amountCents              Int
  currency                 String                    @default("usd")
  description              String
  status                   GeneratedAppPaymentStatus
  providerChargeId         String?
  failureReason            String?
  createdAt                DateTime                  @default(now())

  @@index([projectId])
  @@map("generated_app_payments")
}

// ---------------------------------------------------------------------------
// Deployment (Master Spec §61: "Development, Preview, Staging, and
// Production environments; supported deployment; deployment evidence and
// rollback"). `environment` is modeled as a field on this append-only
// record rather than a separate Environment entity -- there is nothing to
// configure per environment beyond which one a given deployment targets.
// No specific hosting vendor is named or implemented (unlike payments,
// where "e.g. Stripe" was already a named illustrative example in this
// codebase's own seed data) -- DeploymentProvider is a real interface with
// only a mock implementation today (see src/lib/deployment). The record
// keeping and rollback state machine here are real regardless of which
// provider performs the underlying push.
// ---------------------------------------------------------------------------

enum DeploymentEnvironment {
  DEVELOPMENT
  PREVIEW
  STAGING
  PRODUCTION
}

enum DeploymentStatus {
  SUCCEEDED
  FAILED
  ROLLED_BACK
}

model Deployment {
  id          String                @id @default(cuid())
  projectId   String
  project     Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environment DeploymentEnvironment
  status      DeploymentStatus

  blueprintVersion Int
  buildPlanVersion Int

  provider             String
  providerDeploymentId String?
  failureReason        String?

  createdAt       DateTime @default(now())
  createdByUserId String

  @@index([projectId, environment, createdAt])
  @@map("deployments")
}

// Master Spec §61 "production exports" -- a real, append-only audit fact
// for every export attempt (who, when, which project), independent of the
// export bundle's own content (see src/lib/generation/export.ts).
model ExportRecord {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  exportVersion   String
  createdAt       DateTime @default(now())
  createdByUserId String

  @@index([projectId, createdAt])
  @@map("export_records")
}

// ---------------------------------------------------------------------------
// Store submission workflow (Master Spec §61: "iOS/Android build workflows,
// testing tracks, submission packages, approval, status tracking,
// rejection/remediation, releases/updates"). Developer-account connection
// itself reuses the existing generic IntegrationRequirement/
// CredentialReference vault (P3-05) rather than a parallel credential
// system -- category "apple_developer_account" / "google_play_account".
// One row per submission attempt (mutable in place across its own
// lifecycle, unlike Deployment's one-row-per-attempt shape) -- "rejection/
// remediation" is a new submission with a new version/buildNumber, the
// same append-more-attempts pattern as Deployment, not an edit of the
// rejected row.
// ---------------------------------------------------------------------------

enum StoreSubmissionPlatform {
  IOS
  ANDROID
}

enum StoreSubmissionTrack {
  INTERNAL_TESTING
  BETA
  PRODUCTION
}

enum StoreSubmissionStatus {
  IN_REVIEW
  APPROVED
  REJECTED
  RELEASED
}

model StoreSubmission {
  id          String                  @id @default(cuid())
  projectId   String
  project     Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  platform    StoreSubmissionPlatform
  track       StoreSubmissionTrack
  version     String
  buildNumber Int
  status      StoreSubmissionStatus

  basedOnBlueprintVersion Int
  rejectionReason         String?

  createdAt       DateTime @default(now())
  createdByUserId String
  updatedAt       DateTime @updatedAt

  @@index([projectId, platform, createdAt])
  @@map("store_submissions")
}

// Generic per-project record store. `modelKey` corresponds to a name in the
// project's Blueprint `dataModels` (e.g. "Record", "Payment") — validated
// against the Blueprint at write time by the service layer, not by a
// database constraint, since the set of valid keys is itself
// project-specific and versioned.
model GeneratedRecord {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  modelKey  String
  data      Json

  ownerGeneratedAppUserId String?
  ownerGeneratedAppUser   GeneratedAppUser? @relation(fields: [ownerGeneratedAppUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([projectId, modelKey])
  @@map("generated_records")
}

// ---------------------------------------------------------------------------
// Conversational editing / Change Sets (Master Spec §27, §57, Phase 2).
// ---------------------------------------------------------------------------

enum ChangeSetStatus {
  PENDING
  APPLIED
  REJECTED
}

// One Change Set per governing Decision (1:1) — a Change Set is the
// structured record of *what an edit_request would change*, computed at
// the same time the Decision is recorded; applying it is a separate step
// gated by that Decision's approval status (Master Spec §15), never
// silently applied ahead of it.
model ChangeSet {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  decisionId String   @unique
  decision   Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  sourceText           String
  priorIdea            String
  combinedIdea         String
  impactCategories     Json
  addedCategories      Json
  requiresRegeneration Boolean

  status                    ChangeSetStatus
  resultSummary             String?
  resultingBlueprintVersion Int?
  resultingBuildPlanVersion Int?

  createdAt DateTime  @default(now())
  appliedAt DateTime?

  @@index([projectId])
  @@map("change_sets")
}

// ---------------------------------------------------------------------------
// Durable jobs (Master Spec §29, Phase 2). Every generation call today
// (generateApplication, P2-06) is a single synchronous request/response
// with no persisted job record — this gives the longest-running, most
// failure-prone operation that exists so far a real status, checkpoint,
// idempotency key, and retry count, without rewriting generateApplication
// itself (it is wrapped, not modified — see D-0034).
// ---------------------------------------------------------------------------

enum JobType {
  GENERATION
}

enum JobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

model JobRun {
  id             String    @id @default(cuid())
  projectId      String
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  jobType        JobType
  status         JobStatus
  idempotencyKey String?
  checkpoint     Json?
  attempt        Int       @default(1)
  error          String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  startedAt   DateTime?
  completedAt DateTime?

  @@unique([projectId, jobType, idempotencyKey])
  @@index([projectId])
  @@map("job_runs")
}
